// Prisma Schema for Gabinete Parlamentar (e-Gabinete) & Democracia Digital

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// Core Parliamentary System
// ----------------------------------------------------

model Partido {
  id             String     @id @default(uuid()) @db.Uuid
  sigla          String     @db.VarChar(10)
  nome           String     @db.VarChar(100)
  cor_primaria   String?    @db.VarChar(20)
  cor_secundaria String?    @db.VarChar(20)
  cor_terciaria String?    @db.VarChar(20)
  deputados      Deputado[]

  @@map("partidos")
}

model Deputado {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String    @db.VarChar(255)
  slug           String?   @unique @db.VarChar(255)
  id_partido     String?   @db.Uuid
  estado         String    @db.VarChar(2)
  foto_url       String?
  ativo          Boolean   @default(true)
  partido        Partido?  @relation(fields: [id_partido], references: [id])
  
  // Relations to Gabinete
  pessoas        Pessoa[]
  entidades      Entidade[]
  agendas        AgendaCompromisso[]
  audiencias     SolicitacaoAudiencia[]
  demandas       AtendimentoDemanda[]
  oficios        Oficio[]
  ligacoes       LigacaoRecebida[]
  visitas        RegistroVisita[]
  recados        Recado[]
  projetos       Projeto[]
  emendas        Orcamento[]

  @@map("deputado")
}

model Perfil {
  id          String    @id @default(uuid()) @db.Uuid
  nome        String    @db.VarChar(100)
  descricao   String?
  permissoes  Json?
  usuarios    Usuario[]

  @@map("perfis")
}

model Usuario {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique @db.VarChar(255)
  nome        String   @db.VarChar(255)
  id_deputado String?  @db.Uuid
  id_perfil   String?  @db.Uuid
  is_admin    Boolean  @default(false)
  ativo       Boolean  @default(true)
  perfil      Perfil?  @relation(fields: [id_perfil], references: [id])

  @@map("usuarios")
}

// ----------------------------------------------------
// e-Gabinete Module Models
// ----------------------------------------------------

enum CategoriaPessoa {
  LIDERANCA
  ELEITOR
  AUTORIDADE
  SERVIDOR
  IMPRENSA
  OUTRO
}

model Pessoa {
  id              String           @id @default(uuid()) @db.Uuid
  id_deputado     String           @db.Uuid
  nome            String           @db.VarChar(255)
  apelido         String?          @db.VarChar(100)
  cpf             String?          @db.VarChar(14)
  rg              String?          @db.VarChar(20)
  data_nascimento DateTime?        @db.Date
  profissao       String?          @db.VarChar(100)
  categoria       CategoriaPessoa  @default(ELEITOR)
  
  // Contato
  celular1        String?          @db.VarChar(20)
  celular2        String?          @db.VarChar(20)
  telefone_res    String?          @db.VarChar(20)
  telefone_com    String?          @db.VarChar(20)
  whatsapp        Boolean          @default(true)
  email           String?          @db.VarChar(255)

  // Endereço
  cep             String?          @db.VarChar(10)
  logradouro      String?          @db.VarChar(255)
  numero          String?          @db.VarChar(20)
  complemento     String?          @db.VarChar(100)
  bairro          String?          @db.VarChar(100)
  cidade          String?          @db.VarChar(100)
  uf              String?          @db.VarChar(2)

  // Dados Políticos / Redes
  votos_estimados Int?             @default(0)
  instagram       String?          @db.VarChar(100)
  facebook        String?          @db.VarChar(100)
  observacoes     String?
  cadastrado_por  String?          @db.VarChar(100)
  created_at      DateTime         @default(now())

  deputado        Deputado         @relation(fields: [id_deputado], references: [id], onDelete: Cascade)
  demandas        AtendimentoDemanda[]
  visitas         RegistroVisita[]

  @@map("gabinete_pessoas")
}

model Entidade {
  id              String     @id @default(uuid()) @db.Uuid
  id_deputado     String     @db.Uuid
  razao_social    String     @db.VarChar(255)
  nome_fantasia   String?    @db.VarChar(255)
  cnpj            String?    @db.VarChar(18)
  tipo            String     @default("Associação") @db.VarChar(100)
  responsavel     String?    @db.VarChar(255)
  cargo_resp      String?    @db.VarChar(100)
  
  // Contatos
  telefone        String?    @db.VarChar(20)
  email           String?    @db.VarChar(255)
  cidade          String?    @db.VarChar(100)
  uf              String?    @db.VarChar(2)

  deputado        Deputado   @relation(fields: [id_deputado], references: [id], onDelete: Cascade)
  demandas        AtendimentoDemanda[]

  @@map("gabinete_entidades")
}

enum TipoVisibilidadeAgenda {
  PUBLICO
  RESERVADO
  PESSOAL
}

enum StatusAgenda {
  CONFIRMADO
  PENDENTE
  CANCELADO
  REALIZADO
}

model AgendaCompromisso {
  id                   String                 @id @default(uuid()) @db.Uuid
  id_deputado          String                 @db.Uuid
  data_inicio          DateTime
  data_fim             DateTime
  compromisso          String                 @db.VarChar(255)
  pauta_descritivo     String?
  local                String?                @db.VarChar(255)
  link_maps            String?
  visibilidade         TipoVisibilidadeAgenda @default(PUBLICO)
  status               StatusAgenda           @default(PENDENTE)
  cor_destaque         String?                @default("#005baa") @db.VarChar(20)
  assessor_responsavel String?                @db.VarChar(100)
  solicitado_por       String?                @db.VarChar(100)
  alerta_sms           Boolean                @default(false)
  created_at           DateTime               @default(now())

  deputado             Deputado               @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_agendas")
}

model SolicitacaoAudiencia {
  id                   String     @id @default(uuid()) @db.Uuid
  id_deputado          String     @db.Uuid
  personalidade        String     @db.VarChar(255)
  pauta                String
  data_solicitacao     DateTime   @default(now())
  assessor_responsavel String?    @db.VarChar(100)
  status               String     @default("Solicitada") @db.VarChar(50)
  cadastrado_por       String?    @db.VarChar(100)

  deputado             Deputado   @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_audiencias")
}

enum StatusDemanda {
  CADASTRADO
  EM_ANDAMENTO
  ENCAMINHADO
  ATENDIDO
  ATENDIDO_PARCIALMENTE
  CANCELADO
  NAO_ATENDIDO
}

model AtendimentoDemanda {
  id                   String         @id @default(uuid()) @db.Uuid
  id_deputado          String         @db.Uuid
  processo             String         @db.VarChar(50)
  prioridade           String         @default("Normal") @db.VarChar(20)
  
  id_pessoa            String?        @db.Uuid
  id_entidade          String?        @db.Uuid
  interessado_nome     String         @db.VarChar(255)
  
  assunto              String
  tipo_atendimento     String         @db.VarChar(100)
  destinatario_orgao   String?        @db.VarChar(255)
  
  status               StatusDemanda  @default(CADASTRADO)
  valor_estimado       Decimal?       @default(0.00) @db.Decimal(15, 2)
  assessor_responsavel String?        @db.VarChar(100)
  data_abertura        DateTime       @default(now())
  
  pessoa               Pessoa?        @relation(fields: [id_pessoa], references: [id])
  entidade             Entidade?      @relation(fields: [id_entidade], references: [id])
  deputado             Deputado       @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_demandas")
}

model Oficio {
  id                   String     @id @default(uuid()) @db.Uuid
  id_deputado          String     @db.Uuid
  numero_oficio        String     @db.VarChar(50)
  data_emissao         DateTime   @db.Date
  interessado          String     @db.VarChar(255)
  destinatario         String     @db.VarChar(255)
  assunto              String
  assessor_responsavel String?    @db.VarChar(100)
  status               String     @default("Enviado") @db.VarChar(50)
  arquivo_url          String?

  deputado             Deputado   @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_oficios")
}

model LigacaoRecebida {
  id                 String     @id @default(uuid()) @db.Uuid
  id_deputado        String     @db.Uuid
  data_hora          DateTime   @default(now())
  ficha              Int?       @default(autoincrement())
  nome_solicitante   String     @db.VarChar(255)
  telefone           String     @db.VarChar(30)
  pessoa_procurada   String     @db.VarChar(100)
  assunto            String
  atendido_por       String     @db.VarChar(100)
  retorno_necessario Boolean    @default(true)
  status_retorno     String     @default("Sem retorno") @db.VarChar(50)

  deputado           Deputado   @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_ligacoes")
}

model RegistroVisita {
  id                 String     @id @default(uuid()) @db.Uuid
  id_deputado        String     @db.Uuid
  ficha              Int        @default(autoincrement())
  data_horario       DateTime   @default(now())
  tipo_visita        String     @default("Recebida") @db.VarChar(50) // Recebida / Efetuada
  lugar              String     @default("Gabinete parlamentar") @db.VarChar(100)
  
  id_pessoa          String?    @db.Uuid
  pessoa_entidade    String     @db.VarChar(255)
  atendido_por       String     @db.VarChar(100)
  assessor           String     @db.VarChar(100)
  motivo             String     @db.VarChar(100)
  resumo_visita      String
  status             String     @default("Atendido") @db.VarChar(50)

  pessoa             Pessoa?    @relation(fields: [id_pessoa], references: [id])
  deputado           Deputado   @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_visitas")
}

model Recado {
  id           String     @id @default(uuid()) @db.Uuid
  id_deputado  String     @db.Uuid
  data_recado  DateTime   @default(now())
  de_quem      String     @db.VarChar(100)
  para_quem    String     @db.VarChar(100)
  mensagem     String
  lido         Boolean    @default(false)
  prioridade   String     @default("Normal") @db.VarChar(20)

  deputado     Deputado   @relation(fields: [id_deputado], references: [id], onDelete: Cascade)

  @@map("gabinete_recados")
}

// ----------------------------------------------------
// Existing System Extensions
// ----------------------------------------------------

model Projeto {
  id            String    @id @default(uuid()) @db.Uuid
  descricao     String
  municipio     String?   @db.VarChar(100)
  id_deputado   String?   @db.Uuid
  valor_projeto Decimal   @default(0.00) @db.Decimal(15, 2)
  status        String?   @default("Elaboração") @db.VarChar(50)
  ementa        String?
  tipo          String?   @db.VarChar(100)
  autor         String?   @db.VarChar(255)
  
  deputado      Deputado? @relation(fields: [id_deputado], references: [id])

  @@map("projetos")
}

model Orcamento {
  id           String    @id @default(uuid()) @db.Uuid
  id_deputado  String?   @db.Uuid
  data         DateTime  @db.Date
  tipo         String    @db.VarChar(50)
  objeto       String?
  valor        Decimal   @db.Decimal(15, 2)
  beneficiario String?   @db.VarChar(100)
  autor        String?   @db.VarChar(255)
  municipio    String?   @db.VarChar(100)

  deputado     Deputado? @relation(fields: [id_deputado], references: [id])

  @@map("orcamentos")
}
